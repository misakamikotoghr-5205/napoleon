extends SceneTree
const T = preload("res://scripts/tests/cards/lib/card_t.gd")
const S = preload("res://scripts/tests/cards/G03/test_support.gd")
func _initialize() -> void:
	var t := T.new(self, "G03_dossier")
	var e := S.engine()
	var ctx := e.ctx
	S.fragment(ctx, "df.one", "test")
	S.fragment(ctx, "df.two", "test")
	S.fragment(ctx, "df.after", "test", "year_after", "df.one", ["1939"])
	S.fragment(ctx, "df.unseen", "unseen")
	S.card(ctx, "dp.test", {"type": "dossier_page", "person": "test", "fragments": ["df.one", "df.after"], "effects": {"on_complete": [{"op": "counter", "key": "complete", "delta": 1}]}}, &"discard")
	t.eq(CardDossier.view(ctx)["pages"], [], "unseen people not listed")
	CardDossier.add(ctx, "df.one")
	CardDossier.add(ctx, "df.one")
	t.eq(ctx.state.ns("rules")["dossier"]["test"]["have"], ["df.one"], "duplicate add ignored")
	CardDossier.gap(ctx, "df.two")
	CardDossier.add(ctx, "df.two")
	t.ok(not CardDossier.has_fragment(ctx, "df.two"), "gap permanent")
	t.eq(CardDossier.year_after(ctx), [], "wrong era does not add")
	ctx.hooks.fire(ctx, &"year_jump", {"from": "1938", "to": "1939"})
	t.ok(CardDossier.has_fragment(ctx, "df.after"), "year hook target era before stage advance")
	ctx.state.ns("loop")["stage"] = 1
	t.eq(CardDossier.year_after(ctx), [], "year after does not repeat previous fragment")
	t.ok(CardDossier.complete(ctx, "test"), "page complete")
	t.eq(ctx.state.ns("rules")["counters"]["complete"], 1, "complete effect once")
	CardDossier.year_after(ctx)
	t.eq(ctx.state.ns("rules")["counters"]["complete"], 1, "complete no repeats")
	var v := CardDossier.view(ctx)
	t.eq(v["pages"].size(), 1, "only seen person")
	t.eq(v["pages"][0]["fragments"].size(), 3, "have and gaps only")
	t.ok((v["pages"][0]["fragments"] as Array).any(func(f: Dictionary) -> bool: return f["state"] == "gap"), "gap visible")
	t.no_leaks(v)
	CardDemands.on_settle(ctx)
	t.eq(CardDossier.view(ctx)["pages"][0]["new"], 0, "new cleared at settle")
	var clone := S.clone(e)
	CardDossier.add(clone.ctx, "df.two")
	t.eq(clone.ctx.state.hash(), ctx.state.hash(), "gap survives save restore")
	t.finish()

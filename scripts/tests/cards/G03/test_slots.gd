extends SceneTree
const T = preload("res://scripts/tests/cards/lib/card_t.gd")
const S = preload("res://scripts/tests/cards/G03/test_support.gd")
const H = preload("res://scripts/cards/rules/rules_helpers.gd")
func _initialize() -> void:
	var t := T.new(self, "G03_slots")
	var e := S.engine()
	var ctx := e.ctx
	var uid := S.event(ctx)
	var uid2 := S.event(ctx)
	t.eq(e.send(&"slot.place", {"uid": uid, "slot": "man", "source": {"kind": "self"}})["coins"], 2, "person coins")
	t.eq(CardSlots.can_place(ctx, uid2, "man", {"kind": "self"}), "person_busy", "person reservation")
	t.eq(CardSlots.can_place(ctx, uid, "man", {"kind": "self"}), "slot_full", "slot max")
	t.eq(CardSlots.can_place(ctx, uid, "cash", {"kind": "self"}), "slot_reject", "accepts")
	t.ok(e.send(&"slot.remove", {"uid": uid, "slot": "man", "index": 0})["ok"], "remove")
	t.eq(CardSlots.can_place(ctx, uid2, "man", {"kind": "self"}), "", "remove releases person")
	ctx.run([{"op": "person_state", "person": "ruhua", "state": "away", "days": 2}], "test")
	t.eq(CardSlots.can_place(ctx, uid, "man", {"kind": "self"}), "person_busy", "away busy")
	ctx.run([{"op": "person_state", "person": "ruhua", "state": "ok"}], "test")
	CardSlots.place(ctx, uid, "man", {"kind": "self"})
	CardSlots.place(ctx, uid, "cash", {"kind": "money", "amount": 49})
	t.eq(ctx.state.ns("rules")["test_money"], 500, "placement reserves money")
	t.eq(CardSlots.preview(ctx, uid)["coins"], 6, "person plus floor money coins")
	t.eq(CardSlots.can_place(ctx, uid2, "cash", {"kind": "money", "amount": 460}), "insufficient_money", "global money reservation")
	var kept := CardPiles.spawn(ctx, "kp.ma_owes", &"kept")
	CardSlots.place(ctx, uid, "kept", {"kind": "kept", "uid": kept})
	t.eq(CardSlots.preview(ctx, uid)["auto_heads"], 3, "kept heads")
	var rolled := e.send(&"slot.roll", {"uid": uid})
	t.ok(rolled["success"], "automatic heads success")
	t.eq(ctx.state.ns("rules")["test_money"], 451, "roll pays exactly once")
	t.eq(CardPiles.zone_of(ctx, kept), &"discard", "consumed kept")
	t.eq(CardSlots.can_place(ctx, uid2, "man", {"kind": "self"}), "person_busy", "person used today")
	t.eq(CardSlots.reserved_money(ctx), 0, "resolved reservations cleared")
	ctx.state.ns("loop")["abs_day"] = 2
	t.eq(CardSlots.can_place(ctx, uid2, "man", {"kind": "self"}), "", "person new day")
	t.eq(CardSlots.can_place(ctx, "missing", "man", {"kind": "self"}), "unknown_uid", "unknown target")
	var required := S.card(ctx, "ev.required", {"type": "event", "slots": [{"id": "man", "accepts": ["self"], "required": true}], "check": {"need": 1}})
	t.eq(CardSlots.roll(ctx, required)["err"], "slot_required", "required slot")
	t.no_leaks(e.query(&"slots", {"uid": uid2}))
	_test_resources(t)
	t.finish()

func _test_resources(t) -> void:
	var e := S.engine()
	var ctx := e.ctx
	var uid := S.card(ctx, "ev.resources", {"type": "event", "slots": [{"id": "item", "accepts": ["item"], "item_match": {"cat": "rice"}}, {"id": "news", "accepts": ["news"]}], "check": {"need": 0}})
	ctx.state.ns("econ")["items_meta"] = {"i1": {"template": "rice.ordinary", "cat": "rice"}, "i2": {"template": "coal.ordinary", "cat": "coal"}}
	ctx.state.ns("econ")["ledger"] = {"items": {"i1": {"location": "stock"}, "i2": {"location": "stock"}}}
	t.eq(CardSlots.can_place(ctx, uid, "item", {"kind": "item", "item": "i2"}), "slot_reject", "item matching category")
	t.eq(CardSlots.place(ctx, uid, "item", {"kind": "item", "item": "i1"})["coins"], 1, "item coins")
	var news := S.card(ctx, "nw.slot", {"type": "news"})
	t.eq(CardSlots.place(ctx, uid, "news", {"kind": "news", "uid": news})["coins"], 1, "news coins")
	t.eq(CardSlots.preview(ctx, uid)["coins"], 2, "item plus news coins")
	var event := S.event(ctx)
	ctx.run([{"op": "contact_gain", "person": "ma"}], "test")
	var contact := H.contact_uid(ctx, "ma")
	var kept := CardPiles.spawn(ctx, "kp.ma_owes", &"kept")
	ctx.state.ns("fate")["wheels"] = {"wh:test": {"result": {}, "stake": kept, "incense": [{"kind": "contact", "uid": contact}, {"kind": "money", "amount": 480}]}}
	t.eq(CardSlots.can_place(ctx, event, "man", {"kind": "contact", "uid": contact}), "person_busy", "wheel contact reservation")
	t.eq(CardSlots.can_place(ctx, event, "kept", {"kind": "kept", "uid": kept}), "not_allowed", "wheel stake reservation")
	t.eq(CardSlots.can_place(ctx, event, "cash", {"kind": "money", "amount": 30}), "insufficient_money", "wheel money reservation")
	for status in ["hurt", "jailed", "away"]:
		CardEffectsCore.set_person(ctx, "ruhua", status, 3)
		t.eq(CardSlots.can_place(ctx, event, "man", {"kind": "self"}), "person_busy", "person status " + status)

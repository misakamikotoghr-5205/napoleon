extends SceneTree
const T = preload("res://scripts/tests/cards/lib/card_t.gd")
const S = preload("res://scripts/tests/cards/G03/test_support.gd")
func _initialize() -> void:
	var t := T.new(self, "G03_choices")
	var e := S.engine()
	var ctx := e.ctx
	var uid := S.card(ctx, "ev.choices", {"type": "event", "choices": [{"id": "blocked", "conditions": {"flag": "missing"}}, {"id": "poor", "cost": {"money": 501}}, {"id": "check", "cost": {"money": 10}, "check": {"slots": [{"id": "you", "accepts": ["self"], "attr": "eye"}], "need": 0, "on_success": [{"op": "flag", "key": "done"}]}, "almanac": ["repair"]}, {"id": "direct", "effects": [{"op": "flag", "key": "direct"}]}]})
	var options := CardChoices.options(ctx, uid)
	t.ok(not options[0]["enabled"] and not options[1]["enabled"], "condition/money disabled")
	t.eq(CardChoices.choose(ctx, uid, "blocked")["err"], "cond_failed", "condition refuse")
	t.eq(CardChoices.choose(ctx, uid, "poor")["err"], "insufficient_money", "cost refuse")
	t.eq(CardChoices.choose(ctx, uid, "unknown")["err"], "no_such_choice", "unknown choice")
	t.ok(e.send(&"card.choose", {"uid": uid, "choice": "check"})["needs_slots"], "check defers effects")
	t.eq(ctx.state.ns("rules")["test_money"], 490, "cost paid once")
	CardChoices.choose(ctx, uid, "check")
	t.eq(ctx.state.ns("rules")["test_money"], 490, "duplicate choose no extra pay")
	t.eq(CardSlots.slots_of(ctx, uid)[0]["id"], "you", "selected check slots")
	CardSlots.roll(ctx, uid)
	t.ok(ctx.test({"flag": "done"}), "check success effect")
	var uid2 := S.card(ctx, "ev.direct", {"type": "event", "choices": [{"id": "direct", "effects": [{"op": "flag", "key": "direct"}]}]})
	t.ok(CardChoices.choose(ctx, uid2, "direct")["ok"], "direct choice")
	t.ok(ctx.test({"flag": "direct"}), "direct effect")
	var news := S.card(ctx, "nw.read", {"type": "news", "keepable": true, "effects": {"on_read": [{"op": "counter", "key": "read", "delta": 1}]}})
	e.send(&"card.read", {"uid": news})
	e.send(&"card.read", {"uid": news})
	t.eq(ctx.state.ns("rules")["counters"]["read"], 1, "read effect once")
	t.eq(CardPiles.zone_of(ctx, news), &"hand", "read remains hand")
	t.no_leaks(options)
	t.finish()

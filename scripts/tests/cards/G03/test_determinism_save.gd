extends SceneTree
const T = preload("res://scripts/tests/cards/lib/card_t.gd")
const S = preload("res://scripts/tests/cards/G03/test_support.gd")
func _initialize() -> void:
	var t := T.new(self, "G03_determinism_save")
	var first := S.engine(2026)
	var uid := S.event(first.ctx)
	first.send(&"slot.place", {"uid": uid, "slot": "man", "source": {"kind": "self"}})
	var second := S.clone(first)
	var partial_hash := first.ctx.state.hash()
	var path := t.user_dir() + "/state.json"
	var file := FileAccess.open(path, FileAccess.WRITE)
	file.store_string(JSON.stringify(first.ctx.state.to_dict()))
	file.close()
	second.ctx.state = CardState.from_dict(JSON.parse_string(FileAccess.get_file_as_string(path)))
	t.eq(second.ctx.state.hash(), partial_hash, "partial slot save restore")
	for engine in [first, second]:
		engine.send(&"slot.place", {"uid": uid, "slot": "cash", "source": {"kind": "money", "amount": 20}})
		engine.send(&"slot.roll", {"uid": uid})
		engine.ctx.state.ns("loop").merge({"stage_day": 7, "abs_day": 7}, true)
		var demand := CardDemands.issue(engine.ctx)
		CardDemands.delay(engine.ctx, demand)
		engine.ctx.hooks.fire(engine.ctx, &"settle", {})
	t.eq(first.ctx.state.hash(), second.ctx.state.hash(), "same commands after save same hash")
	t.eq(t.find_floats(first.ctx.state.data), PackedStringArray(), "state no floats")
	t.eq(first.ctx.state.ns("rules")["attempts"][uid], 1, "attempt persisted")
	var third := S.clone(first)
	t.eq(CardCoins.toss(first.ctx, uid, 1, 12), CardCoins.toss(third.ctx, uid, 1, 12), "saved next attempt deterministic")
	# Real engine module registration and save envelope also retain partial placements.
	var live := CardEngine.new()
	t.ok(live.new_game({"seed": 7, "only_examples": true, "save_dir": t.user_dir() + "/live"})["ok"], "real engine initializes")
	var live_uid := S.event(live.ctx)
	var live_def := live.ctx.db.def("ev.test")
	t.ok(live.send(&"slot.place", {"uid": live_uid, "slot": "man", "source": {"kind": "self"}})["ok"], "real partial placement")
	var saved_hash := live.ctx.state.hash()
	live.view()
	live.query(&"card", {"uid": live_uid})
	live.query(&"slots", {"uid": live_uid})
	live.query(&"dossier")
	t.eq(live.ctx.state.hash(), saved_hash, "real new-game view and queries read only")
	var live_path := t.user_dir() + "/live_save.json"
	t.ok(live.save_game(live_path)["ok"], "real save envelope")
	t.ok(live.load_game(live_path)["ok"], "real restore envelope")
	t.eq(live.ctx.state.hash(), saved_hash, "real engine partial placements restored")
	live.view()
	live.query(&"slots", {"uid": live_uid})
	live.query(&"dossier")
	t.eq(live.ctx.state.hash(), saved_hash, "real restored view and queries read only")
	live.ctx.db._cards["ev.test"] = live_def
	if CardCurrency.money(live.ctx) > 0: _test_real_money(t, live, live_uid)
	t.finish()

func _test_real_money(t, live: CardEngine, uid: String) -> void:
	# W2: Once G04 is real, exercise the entire public money/slot/demand path.
	var start := CardCurrency.money(live.ctx)
	t.ok(live.send(&"slot.place", {"uid": uid, "slot": "cash", "source": {"kind": "money", "amount": 20}})["ok"], "real money placement")
	t.eq(CardCurrency.money(live.ctx), start, "real money reserved")
	t.ok(live.send(&"slot.roll", {"uid": uid})["ok"], "real money roll")
	t.eq(CardCurrency.money(live.ctx), start - 20, "real slot pay effect")
	var demand := CardPiles.spawn(live.ctx, "dm.1938.money.t1", &"demands")
	t.ok(live.send(&"card.choose", {"uid": demand, "choice": "pay"})["ok"], "real demand choose")
	t.ok(live.send(&"slot.place", {"uid": demand, "slot": "cash", "source": {"kind": "money", "amount": 60}})["ok"], "real demand cash placement")
	t.ok(live.send(&"demand.submit", {"uid": demand})["success"], "real demand submission")
	t.eq(CardCurrency.money(live.ctx), start - 80, "real demand pay effect")
	t.no_leaks(live.view())
	t.eq(t.find_floats(live.ctx.state.data), PackedStringArray(), "real economic state no floats")

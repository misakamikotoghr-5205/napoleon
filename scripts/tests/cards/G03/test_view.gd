extends SceneTree
const T = preload("res://scripts/tests/cards/lib/card_t.gd")
const S = preload("res://scripts/tests/cards/G03/test_support.gd")
func _initialize() -> void:
	var t := T.new(self, "G03_view")
	var e := S.engine()
	var ctx := e.ctx
	var uid := S.event(ctx)
	CardSlots.place(ctx, uid, "cash", {"kind": "money", "amount": 10})
	ctx.run([{"op": "contact_gain", "person": "ma"}, {"op": "conscience", "delta": -30}, {"op": "heat", "delta": 20}], "test")
	var demand := CardPiles.spawn(ctx, "dm.1938.info.t3", &"demands")
	var before := ctx.state.hash()
	var view := e.view()
	t.no_leaks(view)
	var slots := e.query(&"slots", {"uid": uid})
	t.no_leaks(slots)
	t.eq(slots.keys().size(), 6, "mock slots shape six fields")
	t.ok(slots["slots"][0].has("wants") and not slots["slots"][0].has("tags"), "slot wants")
	t.eq(e.query(&"dossier"), {"pages": []}, "mock dossier shape")
	var cv := CardViewModel.card_view(ctx, demand, true)
	t.eq(cv["demand"], {"kind": "info", "tier": 3}, "demand kind and current tier")
	t.ok(not cv.has("kind") and not cv.has("tier"), "legacy demand fields absent")
	t.ok(not CardViewModel.card_view(ctx, uid, true).has("demand"), "non-demand has no demand view")
	t.no_leaks(cv)
	t.no_leaks(ctx.out)
	t.eq(ctx.state.hash(), before, "view and queries read only")
	t.ok(not view.has("conscience") and not view.has("rep") and not view.has("heat"), "hidden point fields absent")
	t.eq(view["heat_tier"], 1, "visible heat tier")
	_test_demand_amount(t)
	t.finish()

func _test_demand_amount(t) -> void:
	var e := S.engine(17)
	var ctx := e.ctx
	ctx.state.ns("loop").merge({"stage_day": 7, "abs_day": 7}, true)
	ctx.db._by_type["demand"] = ["dm.1938.money.t1"]
	ctx.run([{"op": "demand_tier", "delta": 1}], "test/contact_passive")
	var issued := CardDemands.issue(ctx)
	var cv := e.query(&"card", {"uid": issued})
	t.eq(cv["demand"], {"kind": "money", "tier": 1}, "contact passive tier visible")
	t.ok(CardDemands.delay(ctx, issued)["ok"], "delay demand for view")
	t.eq(e.query(&"card", {"uid": issued})["demand"], {"kind": "money", "tier": 2}, "delayed current tier visible")
	var actual := int(ctx.state.ns("rules")["demand"]["issued"][issued]["amount"])
	var hash_before := ctx.state.hash()
	cv = e.query(&"card", {"uid": issued})
	t.eq(cv["amount"], actual, "unselected issued jittered amount visible")
	t.no_leaks(cv, "issued amount view")
	t.eq(ctx.state.hash(), hash_before, "amount query read only")
	CardChoices.choose(ctx, issued, "pay")
	t.eq(e.query(&"card", {"uid": issued})["amount"], actual, "pay current issued amount")
	var goods := CardPiles.spawn(ctx, "dm.1938.goods.t0", &"demands")
	CardChoices.choose(ctx, goods, "substitute")
	t.eq(e.query(&"card", {"uid": goods})["amount"], 50, "substitute current amount")
	CardChoices.choose(ctx, goods, "pay")
	t.eq(e.query(&"card", {"uid": goods})["amount"], 0, "goods current noncash mode")
	var info := CardPiles.spawn(ctx, "dm.1938.info.t3", &"demands")
	CardChoices.choose(ctx, info, "fabricate")
	t.eq(e.query(&"card", {"uid": info})["amount"], 0, "fabricate noncash mode")
	# No issue row exists for directly spawned demands; querying must not create it.
	var direct := CardPiles.spawn(ctx, "dm.1938.money.t1", &"demands")
	hash_before = ctx.state.hash()
	t.eq(e.query(&"card", {"uid": direct})["amount"], 60, "direct demand fallback amount")
	t.eq(ctx.state.hash(), hash_before, "fallback amount does not initialize state")
	S.card(ctx, "dm.1938.money.t0", {"type": "demand", "kind": "money", "tier": 0, "era": ["1938"], "resolve": {"money": {"amount": 35}}, "weight": 10}, &"discard")
	ctx.db._cards["dm.1938.money.t1"]["resolve"]["haggle"]["need"] = 0
	CardChoices.choose(ctx, direct, "haggle")
	t.eq(e.query(&"card", {"uid": direct})["amount"], 35, "haggle selected payable amount")
	var cash_before := int(ctx.state.ns("rules")["test_money"])
	t.ok(CardDemands.submit(ctx, direct)["success"], "haggle success")
	t.eq(ctx.state.ns("rules")["test_money"], cash_before - 35, "paid advertised haggle amount")
	t.eq(ctx.state.ns("rules")["demand"]["issued"][direct]["amount"], 35, "issued amount updated after haggle")
	hash_before = ctx.state.hash()
	cv = e.query(&"card", {"uid": direct})
	t.eq(cv["amount"], 35, "resolved haggle actual amount retained")
	t.no_leaks(cv, "resolved demand amount")
	t.eq(ctx.state.hash(), hash_before, "resolved amount view read only")
	t.eq(e.query(&"slots", {"uid": direct}).keys().size(), 6, "slots mock shape preserved")

extends SceneTree
const T = preload("res://scripts/tests/cards/lib/card_t.gd")
const S = preload("res://scripts/tests/cards/G03/test_support.gd")
func _initialize() -> void:
	var t := T.new(self, "G03_meters")
	var e := S.engine()
	var ctx := e.ctx
	t.eq(CardMeters.value(ctx, &"rep"), 10, "initial rep")
	CardMeters.bump_tier(ctx, &"rep", 1, "test")
	t.eq(CardMeters.value(ctx, &"rep"), 20, "bump threshold")
	CardMeters.bump_tier(ctx, &"rep", 10, "test")
	t.eq(CardMeters.value(ctx, &"rep"), 80, "highest threshold")
	CardMeters.add(ctx, &"rep", 15, "test")
	CardMeters.bump_tier(ctx, &"rep", 1, "test")
	t.eq(CardMeters.value(ctx, &"rep"), 95, "highest tier no change")
	CardMeters.bump_tier(ctx, &"rep", -1, "test")
	t.eq(CardMeters.value(ctx, &"rep"), 60, "lower tier threshold")
	var events := ctx.out.size()
	CardMeters.add(ctx, &"conscience", -5, "test")
	t.eq(ctx.out.size(), events, "conscience no event")
	CardMeters.add_attr(ctx, "ruhua", &"eye", 2, 2, "test")
	CardMeters.add_attr(ctx, "ruhua", &"eye", 1, 0, "test")
	t.eq(CardMeters.attr(ctx, "ruhua", &"eye"), 5, "temporary and permanent attr")
	ctx.state.ns("loop")["abs_day"] = 3
	ctx.hooks.fire(ctx, &"day_start", {})
	t.eq(CardMeters.attr(ctx, "ruhua", &"eye"), 3, "temporary expiry restores permanent")
	ctx.hooks.fire(ctx, &"stage_start", {})
	t.eq(CardMeters.attr(ctx, "ruhua", &"eye"), 3, "stage preserves attrs")
	t.eq(CardMeters.value(ctx, &"conscience"), -5, "stage preserves meters")
	CardMeters.add(ctx, &"heat", 10, "test")
	ctx.hooks.fire(ctx, &"settle", {})
	t.eq(CardMeters.value(ctx, &"heat"), 9, "daily heat decay")
	ctx.hooks.fire(ctx, &"settle", {})
	t.eq(CardMeters.value(ctx, &"heat"), 9, "settle once")
	ctx.run([{"op": "contact_gain", "person": "ma"}], "test")
	ctx.hooks.fire(ctx, &"day_start", {})
	t.eq(CardMeters.value(ctx, &"heat"), 11, "contact downside")
	ctx.run([{"op": "flag", "key": "ma_offended"}], "test")
	CardRulesInstall.contact_hook(ctx, "deal")
	t.ok(not ctx.test({"has_contact": "ma"}), "leave_when")
	t.eq(ctx.mods.pct(ctx, &"patience_pct", {}), 115, "rep patience tiers")
	t.no_leaks(e.view())
	_test_modifiers(t)
	_test_contact_pct(t)
	t.finish()

# 人脉 mods 的 pct 是乘数（100 不变）：cats 只管列出的品类；pool_weight 经 pool_pct 进 CardWeights。
func _test_contact_pct(t) -> void:
	var e := S.engine()
	var ctx := e.ctx
	var before := _event_weight(ctx, "ev.1938.police_check")
	S.card(ctx, "ct.cats", {"type": "contact", "person": "cats", "mods": [{"mod": "appraise_pct", "cats": ["art", "medicine"], "pct": 120}], "attrs": {"eye": 3}}, &"contacts")
	t.eq(ctx.mods.pct(ctx, &"appraise_pct", {"cat": "art"}), 120, "contact appraisal cats art")
	t.eq(ctx.mods.pct(ctx, &"appraise_pct", {"cat": "medicine"}), 120, "contact appraisal cats medicine")
	t.eq(ctx.mods.pct(ctx, &"appraise_pct", {"cat": "rice"}), 100, "contact appraisal cats leave other categories")
	t.eq(ctx.mods.pct(ctx, &"appraise_pct", {"cat": ""}), 100, "contact appraisal cats need a category")
	S.card(ctx, "ct.pool", {"type": "contact", "person": "pool", "mods": [{"mod": "pool_weight", "pool": "event", "tags_any": ["search", "police"], "pct": 140}, {"mod": "pool_weight", "pool": "life", "tags_any": [], "pct": 130}, {"mod": "no_intake_cat", "cat": "jewelry"}], "attrs": {"nerve": 3}}, &"contacts")
	t.eq(ctx.mods.pct(ctx, &"pool_pct", {"pool": "event", "def": "ev.1938.police_check"}), 140, "contact pool weight matching tag")
	t.eq(ctx.mods.pct(ctx, &"pool_pct", {"pool": "event", "def": "missing.def"}), 100, "contact pool weight needs a matching tag")
	t.eq(ctx.mods.pct(ctx, &"pool_pct", {"pool": "life", "def": "missing.def"}), 130, "empty tags_any covers the whole pool")
	t.eq(ctx.mods.pct(ctx, &"pool_pct", {"pool": "person", "def": "ev.1938.police_check"}), 100, "contact pool weight other pool")
	t.eq(_event_weight(ctx, "ev.1938.police_check"), before * 140 / 100, "contact pool weight reaches CardWeights")
	t.ok(ctx.mods.any_true(ctx, &"intake_blocked", {"cat": "jewelry"}), "contact no_intake_cat")
	t.ok(not ctx.mods.any_true(ctx, &"intake_blocked", {"cat": "rice"}), "contact no_intake_cat other category")
	CardEffectsCore.set_person(ctx, "pool", "away", 2)
	t.eq(_event_weight(ctx, "ev.1938.police_check"), before, "absent contact no pool weight")
	t.ok(not ctx.mods.any_true(ctx, &"intake_blocked", {"cat": "jewelry"}), "absent contact no intake block")

func _event_weight(ctx: CardCtx, id: String) -> int:
	for row in CardWeights.rows(ctx, &"event"):
		if str(row[0]) == id: return int(row[1])
	return 0

func _test_modifiers(t) -> void:
	var e := S.engine()
	var ctx := e.ctx
	S.card(ctx, "ct.mod", {"type": "contact", "person": "mod", "mods": [{"mod": "shelf_cap", "delta": 2}, {"mod": "kept_cap", "delta": 1}, {"mod": "deal_count", "type": "news", "delta": 1}, {"mod": "appraise_pct", "cat": "book", "pct": 120}], "attrs": {"eye": 3}}, &"contacts")
	t.eq(ctx.mods.sum_int(ctx, &"cap", {"zone": "shelf"}), 2, "contact shelf cap")
	t.eq(ctx.mods.sum_int(ctx, &"cap", {"zone": "kept"}), 1, "contact kept cap")
	t.eq(ctx.mods.sum_int(ctx, &"deal_count", {"type": "news"}), 1, "contact deals")
	t.eq(ctx.mods.pct(ctx, &"appraise_pct", {"cat": "book"}), 120, "contact appraisal matching")
	t.eq(ctx.mods.pct(ctx, &"appraise_pct", {"cat": "rice"}), 100, "contact appraisal mismatch")
	CardEffectsCore.set_person(ctx, "mod", "away", 2)
	t.eq(ctx.mods.sum_int(ctx, &"cap", {"zone": "shelf"}), 0, "absent contact no passive modifier")

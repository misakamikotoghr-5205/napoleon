  "c16.title.tagline": {
    "t": "一九三八年 · 三月 · 青溪镇"
  },
  "c16.title.blurb": {
    "t": "爸妈出门半个月没有音信，哥哥沈如松要去找他们，德厚当交到你手上。每天开门，进门的人一个个走到柜台前：来当的、来卖的、来买的、来赎的。"
  },
  "c16.title.hint": {
    "t": "手里的牌拖到门口，或者点一下再按“打出”，就是请这个人进门。\n每天早上自动存一次；“接着做生意”从那里接上。"
  },

{
  "events": [
    {
      "id": "ev_o_int_hundred_days",
      "pool": "interlude:audience",
      "weight": 0,
      "once": true,
      "requires": {},
      "title": "百日·杜伊勒里宫的召见",
      "location": "巴黎·杜伊勒里宫",
      "speaker": "napoleon",
      "date": "1815-03-21",
      "body": [
        "1815 年 3 月 20 日夜，皇帝回到杜伊勒里宫。国王前一天刚走，宫里的地毯上还绣着百合花。",
        "你没有跟着大军去比利时。皇帝把你留在后方：管钱袋，管船，管那些不管结局如何都得有人管的事。",
        "拿破仑：“维尔福，我问你几件事。回答要快，账要准。”"
      ],
      "questions": [
        {
          "id": "q_purse",
          "q": "国库只够打一场战役。钱先给谁？",
          "a": {
            "label": "先给近卫军和炮兵",
            "effects": {
              "morale": 3
            },
            "rogue": {
              "coins": {
                "medal": 1
              }
            }
          },
          "b": {
            "label": "先留一笔给海军和港口",
            "effects": {},
            "rogue": {
              "coins": {
                "supply": 2
              }
            },
            "flags": [
              "o_ports_funded"
            ]
          }
        },
        {
          "id": "q_petition",
          "q": "马赛来的一摞请愿书，最上面那份写着“法老号大副唐泰斯”。要不要看？",
          "a": {
            "label": "看，今晚就看完",
            "effects": {
              "heat": 2
            },
            "flags": [
              "o_read_petitions"
            ]
          },
          "b": {
            "label": "交给警务部去办",
            "effects": {
              "morale": 1
            }
          }
        },
        {
          "id": "q_after",
          "q": "如果这一仗打输了，你去哪里？",
          "a": {
            "label": "陛下去哪里，我去哪里",
            "effects": {
              "morale": 4
            },
            "flags": [
              "o_sworn_exile"
            ]
          },
          "b": {
            "label": "去罗什福尔，先把船找好",
            "effects": {},
            "rogue": {
              "coins": {
                "intel": 1
              }
            }
          }
        }
      ],
      "_note": "主干在厄尔巴 1815-02-25 分岔；远洋开局先放这张召见，交代百日王朝里主角在后方。q_petition 是唐泰斯获释的伏笔，下一张马尔梅松牌把它写实。",
      "interlude": "audience",
      "chapters": [
        "prologue"
      ]
    },
    {
      "id": "ev_o_malmaison",
      "pool": "fixed",
      "weight": 0,
      "once": true,
      "requires": {},
      "title": "马尔梅松的钱袋",
      "location": "马尔梅松",
      "speaker": "villefort",
      "date": "1815-06-29",
      "body": [
        "6 月 18 日，滑铁卢。战报是三天后才到巴黎的，信使的马在宫门口倒下就没再起来。6 月 22 日，皇帝第二次退位。",
        "6 月 29 日，马尔梅松。普鲁士骑兵离这里只有半天的路，布吕歇尔放话要把皇帝抓回去。银行家拉菲特坐在约瑟芬留下的客厅里，面前摊着收据。",
        "拉菲特：“陛下的钱可以存在我这里，只带一张收据走。英国人搜得到金子，搜不到收据。”",
        "你的公文包里还有一份旧文件：百日王朝那几个月，马赛送来的请愿书。莫雷尔船东求释放法老号的大副唐泰斯，旁边是王家检察官杰拉尔·德·维尔福的批注。那天夜里你在释放令上签了字，又在同一座监狱的名册上，添了一个关了四年的意大利神甫的名字。两个人同一天走出了伊夫堡。",
        "维尔福：“陛下，马车在门口。往西走，去罗什福尔。”"
      ],
      "appraisals": [
        {
          "id": "laffitte_receipt",
          "kind": "weigh",
          "label": "过秤：点验存进拉菲特银行的金子",
          "observation": "分量和收据上的数一枚不差。拉菲特是个规矩的银行家。"
        },
        {
          "id": "gerard_note",
          "kind": "decode",
          "label": "破译杰拉尔的批注",
          "observation": "他亲笔写着：“危险的波拿巴分子，宜永久羁押。”字迹和你家祖宅门楣上刻的姓一样工整。"
        }
      ],
      "choices": [
        {
          "id": "deposit_laffitte",
          "label": "把钱存进拉菲特银行，只带收据和皇帝上路",
          "effects": {
            "morale": 3
          },
          "rogue": {
            "coins": {
              "gold": 1
            }
          },
          "flags": [
            "o_laffitte_receipt"
          ]
        },
        {
          "id": "carry_gold",
          "label": "把金子缝进车厢夹板，随身带走",
          "effects": {
            "heat": 8
          },
          "rogue": {
            "coins": {
              "gold": 3
            }
          },
          "flags": [
            "o_gold_carried"
          ]
        },
        {
          "id": "keep_gerard_note",
          "label": "把请愿书和杰拉尔的批注一起收进怀里",
          "requires_clues": [
            "gerard_note"
          ],
          "effects": {},
          "rogue": {
            "coins": {
              "intel": 2
            }
          },
          "flags": [
            "o_gerard_note_kept"
          ]
        }
      ],
      "_note": "远洋段的起点节点（maps/world.json prologue.malmaison）。这张牌把远洋分支的前提写成定局：唐泰斯和法利亚在百日王朝里获释，所以 1819 年他已经是基督山伯爵。o_gerard_note_kept 在 ev_o_kinsman_letter 里用得上。"
    },

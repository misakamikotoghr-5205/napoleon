      "body": [
        "1808 年春，战争部。参谋长贝尔蒂埃一边写字一边问话，从来不抬头。",
        "贝尔蒂埃：“第一，从巴约讷到马德里要几天？第二，路上的井，有几口是我们的？”"
      ],
      "appraisals": [],
      "chapters": [
        "iberia_danube"
      ],
      "interlude": "audience",
      "questions": [
        {
          "id": "ia_berthier_answer",
          "q": "贝尔蒂埃的两个问题",
          "a": {
            "id": "days_answer",
            "label": "“十九天。井，一口也不是。”",
            "effects": {
              "morale": -1
            },
            "flags": [
              "t_berthier_truth"
            ],
            "rogue": {
              "coins": {
                "intel": 2

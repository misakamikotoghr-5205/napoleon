    {
      "id": "ia_carnot",
      "pool": "interlude:audience",
      "weight": 3,
      "once": true,
      "requires": {},
      "title": "卡尔诺的办公室",
      "location": "巴黎·卢森堡宫",
      "speaker": "villefort",
      "body": [
        "1796 年 2 月，巴黎，卢森堡宫。督政卡尔诺的桌上摊着意大利军团的军需报表，每一页都是红字。",
        "卡尔诺：“有人推荐你去意大利，说你在土伦数过火药桶。我只问一句：那支军团缺的是钱，还是将军？”"
      ],
      "appraisals": [],
      "chapters": [
        "italy"
      ],
      "interlude": "audience",
      "questions": [
        {
          "id": "ia_carnot_answer",
          "q": "卡尔诺的办公室",
          "a": {
            "id": "needs_money",
            "label": "“钱。将军有了，钱没有。”",
            "effects": {
              "treasury": 300
            },
            "flags": [],
            "rogue": {
              "coins": {
                "gold": 1
              }
            }
          },
          "b": {
            "id": "needs_general",
            "label": "“将军。有了对的将军，钱会自己来。”",
            "effects": {
              "morale": 3
            },
            "flags": [
              "t_carnot_general"
            ],
            "rogue": {
              "coins": {
                "medal": 1
              }
            }
          }
        }
      ]
    },

          "delta": 1,
          "why": "林嫂当本公道"
        },
        {
          "op": "set",
          "flag": "lin_pawn",
          "value": "fair"
        }
      ]
    },
    {
      "op": "if",
      "cond": "price() > 130 and price() < 160",

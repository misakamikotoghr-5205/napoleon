    },
    {
      "op": "note",
      "kind": "线索",
      "text": "林嫂的金簪当票到期日为第 32 天；她丈夫汇款能否寄到、孩子能否平安生下，是长线。",
      "source": "inferred",
      "via": "linsao"
    },
    {
      "op": "say",
      "who": "linsao",
      "text": "等孩子满月，红蛋先给你送来。"
    }
  ],
  "on_leave": [

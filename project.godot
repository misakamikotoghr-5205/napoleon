; Engine configuration file.
config_version=5

[application]

config/name="鹰旗军需官"
config/description="拿破仑：鹰旗军需官 — 主干与三条分支长篇剧情策略试玩"
run/main_scene="res://scenes/cards/CardGame.tscn"
